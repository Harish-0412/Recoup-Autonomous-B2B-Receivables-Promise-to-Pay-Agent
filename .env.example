# Directory used for local trained-model artifacts. The contents are gitignored.
ML_ARTIFACTS_DIR=./src/ml/artifacts_store

# Shared seed for reproducible synthetic data and model experiments.
ML_RANDOM_SEED=42

# Reply classifier confidence cutoff before routing to a fallback.
ML_CONFIDENCE_THRESHOLD=0.6

# Recovery target: probability of payment within this many days.
RECOVERY_HORIZON_DAYS=30

# Recovery scoring: false keeps the rules-based scorer, true uses the trained
# model (which still falls back to the rules per invoice on any failure).
USE_MODEL_SCORER=false

# Stage C must clear this confidence before a DISPUTE is acted on directly.
# Higher than the general threshold: a false DISPUTE freezes collection on a
# healthy invoice, while a false negative only costs one more reminder.
ML_DISPUTE_CONFIDENCE_THRESHOLD=0.85

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
# "development" or "production". Production refuses to boot while any secret
# below still holds its placeholder value.
APP_ENV=development

# Interactive API docs and SQL echo. Defaults to false in every environment so
# an unconfigured deploy is the safe one; turn it on deliberately for local work.
DEBUG=true

# Browser origins allowed to call this API, comma-separated. Empty means
# same-origin only. Never set this to "*".
# CORS_ORIGINS=http://localhost:3000,https://app.recoup.in

# ---------------------------------------------------------------------------
# Execution
# ---------------------------------------------------------------------------
# true  = render every message in full and log it; nothing is delivered and no
#         payment link is created. Contacts are recorded as SIMULATED, so the
#         run still exercises the caps and the ladder exactly as a live one.
# false = really send email and really create Razorpay links.
#
# Defaults to true. Turning it off is a deliberate decision to put mail in
# front of real customers -- it should never happen because someone forgot.
DRY_RUN=true

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Any postgresql:// form is accepted and normalised to the psycopg driver.
# Schema is applied with `alembic upgrade head`, never by the app at startup.
DATABASE_URL=postgresql://recoup:recoup@localhost:5432/recoup

# Set to "null" behind a server-side pooler (Neon, Supabase, PgBouncer):
# a client-side pool behind a server-side one holds connections it should not.
DB_POOL_MODE=default
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
