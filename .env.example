# Directory used for local trained-model artifacts. The contents are gitignored.
ML_ARTIFACTS_DIR=./src/ml/artifacts_store

# Shared seed for reproducible synthetic data and model experiments.
ML_RANDOM_SEED=42

# Reply classifier confidence cutoff before routing to a fallback.
ML_CONFIDENCE_THRESHOLD=0.6

# Recovery target: probability of payment within this many days.
RECOVERY_HORIZON_DAYS=30

# Recovery scoring: false keeps the rules-based scorer, true uses the trained
# model (which still falls back to the rules per invoice on any failure).
USE_MODEL_SCORER=false

# Stage C must clear this confidence before a DISPUTE is acted on directly.
# Higher than the general threshold: a false DISPUTE freezes collection on a
# healthy invoice, while a false negative only costs one more reminder.
ML_DISPUTE_CONFIDENCE_THRESHOLD=0.85

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
# "development" or "production". Production refuses to boot while any secret
# below still holds its placeholder value.
APP_ENV=development

# Interactive API docs and SQL echo. Defaults to false in every environment so
# an unconfigured deploy is the safe one; turn it on deliberately for local work.
DEBUG=true

# Browser origins allowed to call this API, comma-separated. Empty means
# same-origin only. Never set this to "*".
# CORS_ORIGINS=http://localhost:3000,https://app.recoup.in

# ---------------------------------------------------------------------------
# Execution
# ---------------------------------------------------------------------------
# true  = render every message in full and log it; nothing is delivered and no
#         payment link is created. Contacts are recorded as SIMULATED, so the
#         run still exercises the caps and the ladder exactly as a live one.
# false = really send email and really create Razorpay links.
#
# Defaults to true. Turning it off is a deliberate decision to put mail in
# front of real customers -- it should never happen because someone forgot.
DRY_RUN=true

# ---------------------------------------------------------------------------
# Inbound replies (Promise-to-Pay)
# ---------------------------------------------------------------------------
# Outbound mail sets Reply-To to reply+<invoice>.<signature>@REPLY_INBOUND_DOMAIN,
# which is how a customer's reply is matched to an invoice without parsing the
# subject line. Point this domain's MX records at Resend to receive them.
REPLY_INBOUND_DOMAIN=reply.yourdomain.com

# HMAC key signing those addresses. Change it: without a signature the address
# format is guessable, and anyone could post a reply naming any invoice and
# have a promise recorded against it.
REPLY_ADDRESS_SECRET=change-me-reply-address-secret

# Signing secret for Resend's inbound webhook (Svix scheme).
RESEND_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxx

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Any postgresql:// form is accepted and normalised to the psycopg driver.
# Schema is applied with `alembic upgrade head`, never by the app at startup.
DATABASE_URL=postgresql://recoup:recoup@localhost:5432/recoup

# Set to "null" behind a server-side pooler (Neon, Supabase, PgBouncer):
# a client-side pool behind a server-side one holds connections it should not.
DB_POOL_MODE=default
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# ---------------------------------------------------------------------------
# Autonomous runs
# ---------------------------------------------------------------------------
# The schedule lives OUTSIDE this process (Render Cron, GitHub Actions, a
# Kubernetes CronJob). An in-process scheduler double-fires the moment a second
# replica starts, so the app defends itself with a Postgres advisory lock
# instead: a second concurrent trigger is a no-op, not a queued rerun.
#
#   */15 * * * *  curl -fsS -X POST https://<host>/api/v1/tasks/run-batch \
#                   -H "Authorization: Bearer $TASK_API_KEY"

# Bearer token the cron trigger must present. Task endpoints send real email,
# so they are authenticated. An EMPTY value refuses every request rather than
# waving them through -- a deploy that forgot to set it fails visibly.
TASK_API_KEY=

# Operator token for dashboard routes (invoices, reports, policy, review
# queue, classify-preview). Empty falls back to TASK_API_KEY, so a
# single-operator deploy needs only one secret. Set separately to rotate
# dashboard access without touching the cron secret.
API_KEY=

# Per-IP sliding-window cap for ingest + both webhooks (requests/minute,
# per process; put a shared limiter in front for exact global caps).
RATE_LIMIT_PER_MINUTE=60
# Shared Redis rate limiter. Unset falls back to in-process deque.
# Example: redis://user:password@redis-host:6379/0
RATE_LIMIT_REDIS_URL=
# OpenTelemetry OTLP HTTP endpoint (Grafana Cloud Tempo / Honeycomb / local Tempo).
# Example for Grafana Cloud: https://otlp-gateway-prod-us-east-0.grafana.net/otlp
# When unset, traces export to stdout JSON only (no network call).
OTEL_EXPORTER_OTLP_ENDPOINT=
# Grafana headers (set BOTH if you set the endpoint; Basic base64(instanceId:apiToken)).
# Example: Authorization=Basic%20XXXXXXXXX
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_SERVICE_NAME=recoup

# Single-tenant identifier. v1 is deliberately single-tenant
# (see docs/tenancy.md); this reserves the owner key a later split migrates on.
BUSINESS_ID=default

# ---------------------------------------------------------------------------
# Drift detection (nightly job: scripts/run_drift_detection.py)
# ---------------------------------------------------------------------------
# Trailing window the scorer aggregates over, in days (three equal periods).
DRIFT_WINDOW_DAYS=90
# Operator mailbox for drift alerts. Empty means alerts are rendered and
# logged only -- the job never guesses where to send mail.
DRIFT_ALERT_EMAIL=

# Most invoices one triggered run may touch. Calibrated: 80% of the N=2400
# wall-p95 cliff measured in docs/load_test.md. Re-measure before raising.
BATCH_MAX_INVOICES=1920

# Cadence the cron is expected to use. The shipped scheduler calls
# POST /api/v1/tasks/run-batch on this cadence -- see
# .github/workflows/scheduler.yml and render.yaml.
SCHEDULER_INTERVAL_SECONDS=300

# THE KILL SWITCH. Set to false and every outbound message stops, with no
# redeploy. Nothing advances while it is off, so turning it back on resumes
# where the agent left off rather than finding every invoice a rung further
# along. Confirm the live value at GET /api/v1/tasks/status.
SENDING_ENABLED=true

# ---------------------------------------------------------------------------
# Payments (Razorpay, test mode)
# ---------------------------------------------------------------------------
# Publishable key ID + secret for payment-link creation. The key ID is NOT an
# API credential: it is never accepted as a bearer token anywhere.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
# Signature secret Razorpay uses to sign webhook deliveries.
RAZORPAY_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxx

# ---------------------------------------------------------------------------
# Email (Resend)
# ---------------------------------------------------------------------------
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=noreply@yourdomain.com

# ---------------------------------------------------------------------------
# LLM (reply understanding; either key suffices, Groq preferred when both set)
# ---------------------------------------------------------------------------
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# ---------------------------------------------------------------------------
# ERP Integrations (Wave 2)
# ---------------------------------------------------------------------------
# Zoho Books OAuth2
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REDIRECT_URI=http://localhost:8000/api/v1/integrations/zoho/connect

# QuickBooks Online OAuth2 (Intuit)
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_REDIRECT_URI=http://localhost:8000/api/v1/integrations/quickbooks/connect
QBO_ENVIRONMENT=sandbox

# Trailing lookback window for ERP overdue invoice sync (days)
ERP_SYNC_LOOKBACK_DAYS=90

