# Directory used for local trained-model artifacts. The contents are gitignored.
ML_ARTIFACTS_DIR=./src/ml/artifacts_store

# Shared seed for reproducible synthetic data and model experiments.
ML_RANDOM_SEED=42

# Reply classifier confidence cutoff before routing to a fallback.
ML_CONFIDENCE_THRESHOLD=0.6

# Recovery target: probability of payment within this many days.
RECOVERY_HORIZON_DAYS=30

# Recovery scoring: false keeps the rules-based scorer, true uses the trained
# model (which still falls back to the rules per invoice on any failure).
USE_MODEL_SCORER=false
